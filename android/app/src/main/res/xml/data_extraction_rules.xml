<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer: the same rule as backup_rules.xml (SOURCES_DESIGN.md §13). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
